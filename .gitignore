# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Environments
.venv/
.env

# Local artifacts
models/
data/*
!data/.gitkeep
qdrant_storage/
eval/cache/
# Eval run outputs (regenerated by eval.run_eval / eval.e2e.run); READMEs and ISSUES.md stay
eval/results/**/*.json
eval/results/matrix/

# E2E eval caches (answers may quote members-only documents)
eval/e2e/judge_cache.jsonl
eval/e2e/recordings/

# Benchmark results stay local; only the write-ups are tracked
eval/results/**
!eval/results/**/
!eval/results/README.md
!eval/results/e2e/README.md
!eval/results/e2e/ISSUES.md
