# Micro Bot configuration. Copy to .env (local) or paste into your host's environment (prod).
# Every setting not listed here has a tested default in config.py, ingest/settings.py and
# retrieval/settings.py. Never commit real values.

# --- Access ---
# Chat and feedback: clients send `Authorization: Bearer <API_KEY>`
API_KEY=
# Document management: admins send `X-Admin-Key: <ADMIN_API_KEY>`
ADMIN_API_KEY=

# --- LLM providers (free, no credit card), tried in LLM_PROVIDERS order ---
# Without any key the app answers from the passages only.
LLM_PROVIDERS=gemini,groq,cloudflare,openrouter
# Each provider accepts several credentials: set the plural *_API_KEYS as a comma-separated list
# and every key gets its own daily quota, per-minute window and cool-down. The singular key still
# works and is merged with the list. LLM_KEY_STRATEGY picks which one serves the next call:
# least-used (default), round-robin (sticky 3) or fill-first (drain one day at a time).
LLM_KEY_STRATEGY=least-used

# Google Gemini (aistudio.google.com/apikey): main answer model; free content may be used by Google
GEMINI_API_KEY=
# Gemini's free quota is per Google Cloud project, not per key: extra keys help only across
# projects, and Google enforces multi-project rotation as a sybil/ToS violation. Keep one.
GEMINI_API_KEYS=
# Free requests/day per project and model, from AI Studio (Google stopped publishing them)
GEMINI_DAILY_LIMIT=500
GEMINI_REWRITE_DAILY_LIMIT=500

# Groq (console.groq.com/keys): 30 requests/minute, 1000/day, but only 200k tokens/day free
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_DAILY_TOKENS=200000

# Cloudflare Workers AI (dash.cloudflare.com): ~120 answers/day on the free plan
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# A pool of accounts, since the free neurons are per account: "account_id:token,account_id:token"
CLOUDFLARE_ACCOUNTS=

# OpenRouter (openrouter.ai/keys): 50 requests/day free, 1000 once 10 credits were bought
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_DAILY_LIMIT=50

# Overall daily cap across providers; 0 = the sum of the configured pools
LLM_DAILY_LIMIT=0
LLM_RESERVE=5
# Cap on answer tokens; thinking is billed as output, so this also bounds the hidden cost
LLM_MAX_OUTPUT_TOKENS=800
# Rewrite each question with one extra LLM call before retrieval; false = 1 call per question
REWRITE_ENABLED=true

# --- App ---
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Qdrant endpoint (the compose service name)
QDRANT_URL=http://qdrant:6333
