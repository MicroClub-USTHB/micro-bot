# Copy to .env. Only these need a value; every other setting has a tested default in code.
# The full list, with the measurements behind each default: the settings classes in config.py,
# ingest/settings.py and retrieval/settings.py

# Bearer token required by /api/v1/chat and /api/v1/feedback
API_KEY=
# Key sent as X-Admin-Key for document management endpoints
ADMIN_API_KEY=

# --- LLM providers: set any, no credit card needed; tried in LLM_PROVIDERS order ---
# Without any key the app answers from the passages only.
# Google Gemini (aistudio.google.com): main answer model. Free content may be used by Google.
GEMINI_API_KEY=
# Free requests/day of your AI Studio project (shown there): answer model, rewrite model
GEMINI_DAILY_LIMIT=250
GEMINI_REWRITE_DAILY_LIMIT=1000
# Cloudflare Workers AI (dash.cloudflare.com): ~120 answers/day on the free plan
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# OpenRouter (openrouter.ai/keys): 50 requests/day free, 1000 once 10 credits were bought
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_DAILY_LIMIT=50
LLM_PROVIDERS=gemini,cloudflare,openrouter

# --- Optional overrides (defaults shown) ---
# Rewrite each question with one extra LLM call before retrieval; false = 1 call per question
REWRITE_ENABLED=true
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Qdrant endpoint (service name inside docker compose)
QDRANT_URL=http://qdrant:6333
