# Micro Bot configuration. Copy to .env (local) or paste into your host's environment (prod).
# Every setting not listed here has a tested default in config.py, ingest/settings.py and
# retrieval/settings.py. Never commit real values.

# --- Access ---
# Chat and feedback: clients send `Authorization: Bearer <API_KEY>`
API_KEY=
# Document management: admins send `X-Admin-Key: <ADMIN_API_KEY>`
ADMIN_API_KEY=

# --- LLM providers (free, no credit card), tried in LLM_PROVIDERS order ---
# Without any key the app answers from the passages only.
LLM_PROVIDERS=gemini,cloudflare,openrouter
# Google Gemini (aistudio.google.com/apikey): main answer model; free content may be used by Google
GEMINI_API_KEY=
# Free requests/day of your AI Studio project (answer model, rewrite model)
GEMINI_DAILY_LIMIT=250
GEMINI_REWRITE_DAILY_LIMIT=1000
# Cloudflare Workers AI (dash.cloudflare.com): ~120 answers/day on the free plan
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# OpenRouter (openrouter.ai/keys): 50 requests/day free, 1000 once 10 credits were bought
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_DAILY_LIMIT=50
# Overall daily cap across providers, and the margin held back
LLM_DAILY_LIMIT=1500
LLM_RESERVE=5
# Rewrite each question with one extra LLM call before retrieval; false = 1 call per question
REWRITE_ENABLED=true

# --- App ---
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Qdrant endpoint (the compose service name)
QDRANT_URL=http://qdrant:6333
