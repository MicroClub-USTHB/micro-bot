# Micro Bot configuration. Copy to .env (local) or paste into your host's environment (prod).
# Every setting not listed here has a tested default in config.py, ingest/settings.py and
# retrieval/settings.py. Never commit real values.

# --- Access ---
# Chat and feedback: clients send `Authorization: Bearer <API_KEY>`
API_KEY=
# Document management: admins send `X-Admin-Key: <ADMIN_API_KEY>`
ADMIN_API_KEY=

# --- LLM providers (free, no credit card), tried in LLM_PROVIDERS order ---
# Without any key the app answers from the passages only.
LLM_PROVIDERS=gemini,groq,cloudflare,openrouter

# Every provider takes a POOL: paste the keys into the one *_API_KEYS line as a comma-separated
# list with NO spaces, e.g. GEMINI_API_KEYS=key1,key2,key3,key4. One key is the same line,
# shorter. Each entry is a separate credential with its own daily quota, its own per-minute
# window and its own cool-down, so one spent or rate-limited key does not take the whole provider
# out. Blanks are ignored and duplicates dropped; a singular *_API_KEY, if you still set one, is
# merged in front of the list.
#
# LLM_KEY_STRATEGY picks which credential of a provider serves the next call:
#   least-used  spread the load; two keys = twice the per-minute ceiling (default)
#   round-robin one key for 3 calls in a row, then the next (sticky, gentler on upstream)
#   fill-first  drain one key's day before touching the next
LLM_KEY_STRATEGY=least-used

# --- Google Gemini (aistudio.google.com/apikey): answers + query rewrite ---
# Paste the keys here, comma-separated, no spaces:
#   GEMINI_API_KEYS=AIzaSyD-example1,AIzaSyD-example2,AIzaSyD-example3,AIzaSyD-example4
GEMINI_API_KEYS=
# Gemini's free quota is counted per Google Cloud project and per model, not per key: keys of one
# project share a single pool, so a pool here only pays off when the keys belong to different
# projects. A key whose day is spent is taken out until midnight Pacific, not retried.
# Free requests/day per project and model, from AI Studio (Google stopped publishing them):
# the answer model and the rewrite model each get a separate pool of 500.
GEMINI_DAILY_LIMIT=500
GEMINI_REWRITE_DAILY_LIMIT=500

# --- Groq (console.groq.com/keys) ---
# 30 requests/minute, but 8,000 tokens/minute is what a grounded prompt hits first (~2 answers a
# minute), then 200,000 tokens/day (~80 answers) and 1,000 requests/day.
# Paste the keys here, comma-separated, no spaces:
#   GROQ_API_KEYS=gsk_example1,gsk_example2,gsk_example3,gsk_example4,gsk_example5
GROQ_API_KEYS=
# WARNING: Groq's free limits are per ORGANIZATION, not per key, so several keys of one account
# share a single pool and add nothing. What does multiply is the model: every id below is its
# own row in Groq's rate-limit table, so the second one is another 200k tokens/day, same key.
# qwen answers until its day is spent, then 120b takes over; set GROQ_MODELS= to keep
# the faster model alone.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODELS=openai/gpt-oss-120b
GROQ_TPM=8000
GROQ_DAILY_LIMIT=1000
GROQ_DAILY_TOKENS=200000

# --- Cloudflare Workers AI (dash.cloudflare.com): ~350 answers/day on the free plan ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# The free neurons are per ACCOUNT, so a pool is account/token pairs, which is why this one is
# not a plain key list:
#   CLOUDFLARE_ACCOUNTS=account_id_1:token_1,account_id_2:token_2
CLOUDFLARE_ACCOUNTS=

# --- OpenRouter (openrouter.ai/keys): 50 requests/day free, 1000 once 10 credits were bought ---
# Paste the keys here, comma-separated, no spaces:
#   OPENROUTER_API_KEYS=sk-or-v1-example1,sk-or-v1-example2
OPENROUTER_API_KEYS=
OPENROUTER_DAILY_LIMIT=50

# Overall daily cap across providers; 0 = the sum of the configured pools
LLM_DAILY_LIMIT=0
LLM_RESERVE=5
# Cap on answer tokens; thinking is billed as output, so this also bounds the hidden cost
LLM_MAX_OUTPUT_TOKENS=800
# Rewrite each question with one extra LLM call before retrieval; false = 1 call per question
REWRITE_ENABLED=true

# --- App ---
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Qdrant endpoint (the compose service name)
QDRANT_URL=http://qdrant:6333
